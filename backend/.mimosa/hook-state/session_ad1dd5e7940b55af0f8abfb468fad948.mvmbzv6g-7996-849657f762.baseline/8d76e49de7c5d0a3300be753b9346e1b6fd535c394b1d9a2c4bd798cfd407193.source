"""Agent 框架测试：词表匹配 / ICP / 分级 / 注册表 / 工具 / 狩猎图。"""
from __future__ import annotations

import os
import tempfile

import pytest

os.environ.setdefault(
    "VACLEAD_DB", os.path.join(tempfile.mkdtemp(prefix="vaclead-agents-"), "t.db")
)

from app.agents import registry, tools  # noqa: E402
from app.agents.graphs.hunt import run_hunt  # noqa: E402
from app.agents.impl.icp_judge_rule import judge_enterprise  # noqa: E402
from app.agents.impl.lead_qualify_rule import qualify  # noqa: E402
from app.agents.impl.signal_parser_rule import parse_signal  # noqa: E402


# ---- signal_parser ----
def test_signal_title_strong_hit_70():
    r = parse_signal("采购真空泵机组项目公告", "常规内容")
    assert r["hit"] and r["hit_part"] == "title" and r["base_score"] == 70.0
    assert "真空泵" in r["matched_terms"]


def test_signal_body_hit_50():
    r = parse_signal("某学校实验室改造", "本项目需采购真空干燥箱十台")
    assert r["hit"] and r["hit_part"] == "body" and r["base_score"] == 50.0


def test_signal_weak_title_discounted():
    r = parse_signal("镀膜车间扩建询价", "")
    assert r["hit"] and r["base_score"] == 35.0  # 70 × 0.5


def test_signal_no_hit():
    assert parse_signal("办公家具采购", "采购椅子桌子")["hit"] is False


# ---- icp_judge ----
def test_icp_tier1_and_capital():
    r = judge_enterprise(
        "苏州晶芯半导体制造有限公司", "集成电路晶圆制造与封测；半导体器件生产", 8600
    )
    assert r["icp_score"] >= 55 and r["is_competitor"] == 0
    assert any("行业命中" in x["rule"] for x in r["icp_reasons"])


def test_icp_competitor_detected():
    r = judge_enterprise("XX真空设备有限公司", "真空设备制造；真空泵生产销售", 2000)
    assert r["is_competitor"] == 1


def test_icp_cap_between_100_1000():
    r = judge_enterprise("东莞宏联光学镀膜有限公司", "光学镀膜加工；真空镀膜服务", 800)
    assert any("注册资本100-1000万" in x["rule"] for x in r["icp_reasons"])


# ---- lead_qualify ----
def test_grade_boundaries():
    assert qualify(80, 80)["grade"] == "S"
    assert qualify(100, 33.3)["grade"] == "A"   # 40+20=60
    assert qualify(100, 0)["grade"] == "B"      # 40
    assert qualify(0, 0)["grade"] == "-"


# ---- registry ----
def test_registry_factory_all_six():
    for name in (
        "hunt_planner", "entity_resolver", "signal_parser",
        "icp_judge", "lead_qualify", "query_translator",
    ):
        agent = registry.get_agent(name, backend="rule")
        assert agent.backend == "rule"


def test_registry_llm_stub_raises():
    from app.agents.base import run_coroutine

    agent = registry.get_agent("signal_parser", backend="llm")
    with pytest.raises(NotImplementedError):
        run_coroutine(agent.run({"title": "x", "content": ""}))


# ---- tools ----
def test_tool_registry_mcp_schema():
    listing = tools.TOOL_REGISTRY.list_tools()
    names = {t["name"] for t in listing}
    assert "search_enterprises" in names and "fetch_amap_poi" in names
    for t in listing:
        assert "description" in t and "inputSchema" in t


def test_tool_call_placeholder():
    r = tools.TOOL_REGISTRY.call("notify_todo", {})
    assert isinstance(r, dict)


# ---- hunt graph ----
def test_hunt_graph_converges_with_fake_collect():
    def fake_fetch_amap_poi(payload: dict) -> list:
        return [
            {"name": "苏州晶芯半导体制造有限公司", "address": "苏州工业园区"},
            {"name": "苏州纳芯微电子股份有限公司", "address": "苏州工业园区"},
        ]

    tools.TOOL_REGISTRY.register_function("fetch_amap_poi", fake_fetch_amap_poi)
    try:
        final = run_hunt({"city": "苏州", "industry_keys": ["semiconductor"], "target": 2, "max_rounds": 3})
        assert len(final.get("enterprise_ids", [])) >= 1
    finally:
        tools.TOOL_REGISTRY.register_function("fetch_amap_poi", None)
